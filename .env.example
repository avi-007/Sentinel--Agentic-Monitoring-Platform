# Copy this file to .env and adjust as needed. `docker compose up` reads .env
# automatically. Defaults below match the hardcoded defaults in each service's
# common/settings.py, so services also run standalone without a .env file.

# ---- global ----------------------------------------------------------------
LOG_LEVEL=INFO

# ---- kafka ------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
TOPIC_TELEMETRY_RAW=telemetry.raw
TOPIC_ALERTS_TRIGGERED=alerts.triggered
TOPIC_TELEMETRY_PARTITIONS=4
TOPIC_ALERTS_PARTITIONS=2

# ---- postgres -----------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_password

# ---- grafana ------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ---- generator ------------------------------------------------------------
GEN_TICK_INTERVAL_SECONDS=3
GEN_TIME_SCALE_FACTOR=48
GEN_ANOMALY_INJECTION_RATE=0.02
GEN_ANOMALY_COOLDOWN_TICKS=100

# ---- detector -------------------------------------------------------------
DET_WARMUP_EVENTS=120
DET_ROLLING_WINDOW=10
DET_RETRAIN_INTERVAL_EVENTS=500
DET_TRAIN_WINDOW_SIZE=1000
DET_ISO_FOREST_N_ESTIMATORS=100
DET_ISO_FOREST_CONTAMINATION=0.02
DET_EWMA_ALPHA=0.05
DET_THRESHOLD_K=3.0
DET_THRESHOLD_PERCENTILE=95
DET_SCORE_HISTORY_SIZE=200
DET_ALERT_COOLDOWN_SECONDS=60

# ---- agent ------------------------------------------------------------------
# mock = zero cost, zero API key, deterministic. Set to "openai" + provide
# OPENAI_API_KEY to use real GPT-4o.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AGENT_MAX_TOOL_TURNS=6
AGENT_REQUEST_TIMEOUT_SECONDS=30
AGENT_MOCK_SEED=42
