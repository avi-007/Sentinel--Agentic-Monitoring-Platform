{
  "title": "Sentinel Overview",
  "uid": "sentinel-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "tags": ["sentinel"],
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "label": "Host",
        "datasource": { "type": "postgres", "uid": "sentinel-postgres" },
        "query": "SELECT host_id AS __text, host_id AS __value FROM hosts ORDER BY 1",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU %",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "sentinel-postgres" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT to_timestamp(floor(extract(epoch FROM ts) / 15) * 15) AS \"time\", host_id AS \"metric\", avg(cpu_pct) AS \"value\" FROM metrics WHERE $__timeFilter(ts) AND host_id IN ($host) GROUP BY 1, host_id ORDER BY 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory %",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "sentinel-postgres" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT to_timestamp(floor(extract(epoch FROM ts) / 15) * 15) AS \"time\", host_id AS \"metric\", avg(mem_pct) AS \"value\" FROM metrics WHERE $__timeFilter(ts) AND host_id IN ($host) GROUP BY 1, host_id ORDER BY 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency (ms)",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "sentinel-postgres" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT to_timestamp(floor(extract(epoch FROM ts) / 15) * 15) AS \"time\", host_id AS \"metric\", avg(latency_ms) AS \"value\" FROM metrics WHERE $__timeFilter(ts) AND host_id IN ($host) GROUP BY 1, host_id ORDER BY 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Error Rate %",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "sentinel-postgres" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT to_timestamp(floor(extract(epoch FROM ts) / 15) * 15) AS \"time\", host_id AS \"metric\", avg(error_rate_pct) AS \"value\" FROM metrics WHERE $__timeFilter(ts) AND host_id IN ($host) GROUP BY 1, host_id ORDER BY 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Anomaly Score vs Dynamic Threshold",
      "description": "raw_score = -IsolationForest.score_samples(x); threshold is the per-host EWMA(μ,σ)+kσ band with a p95 floor guard (see services/detector/app/dynamic_threshold.py). An alert fires when score crosses threshold and the per-host cooldown allows it.",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "sentinel-postgres" },
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 9 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT to_timestamp(floor(extract(epoch FROM ts) / 15) * 15) AS \"time\", host_id || ' score' AS \"metric\", avg(raw_score) AS \"value\" FROM metrics WHERE $__timeFilter(ts) AND host_id IN ($host) AND raw_score IS NOT NULL GROUP BY 1, host_id ORDER BY 1",
          "rawQuery": true
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawSql": "SELECT to_timestamp(floor(extract(epoch FROM ts) / 15) * 15) AS \"time\", host_id || ' threshold' AS \"metric\", avg(threshold) AS \"value\" FROM metrics WHERE $__timeFilter(ts) AND host_id IN ($host) AND threshold IS NOT NULL GROUP BY 1, host_id ORDER BY 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Active Alerts (1h)",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "sentinel-postgres" },
      "gridPos": { "x": 0, "y": 17, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"value\" FROM alerts WHERE triggered_at > now() - interval '1 hour'",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Avg Agent Confidence (1h)",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "sentinel-postgres" },
      "gridPos": { "x": 6, "y": 17, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT avg(confidence) AS \"value\" FROM agent_runs WHERE created_at > now() - interval '1 hour'",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Triggered Alerts + Agent Diagnosis",
      "type": "table",
      "datasource": { "type": "postgres", "uid": "sentinel-postgres" },
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 22 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "time" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          },
          {
            "matcher": { "id": "byName", "options": "host_id" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          },
          {
            "matcher": { "id": "byName", "options": "service_name" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          },
          {
            "matcher": { "id": "byName", "options": "severity" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "critical": { "color": "red", "index": 0 } } },
                  { "type": "value", "options": { "warning": { "color": "orange", "index": 1 } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          },
          {
            "matcher": { "id": "byName", "options": "score" },
            "properties": [{ "id": "custom.width", "value": 80 }]
          },
          {
            "matcher": { "id": "byName", "options": "threshold" },
            "properties": [{ "id": "custom.width", "value": 80 }]
          },
          {
            "matcher": { "id": "byName", "options": "root_cause" },
            "properties": [
              { "id": "custom.width", "value": 350 },
              { "id": "custom.cellOptions", "value": { "type": "auto", "wrapText": true } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "proposed_fix" },
            "properties": [
              { "id": "custom.width", "value": 350 },
              { "id": "custom.cellOptions", "value": { "type": "auto", "wrapText": true } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT a.triggered_at AS \"time\", a.host_id, a.service_name, a.severity, a.status, round(a.raw_score::numeric, 3) AS score, round(a.threshold::numeric, 3) AS threshold, r.root_cause, r.proposed_fix, round(r.confidence::numeric, 2) AS confidence FROM alerts a LEFT JOIN LATERAL (SELECT * FROM agent_runs ar WHERE ar.alert_id = a.alert_id ORDER BY ar.created_at DESC LIMIT 1) r ON true WHERE $__timeFilter(a.triggered_at) AND a.host_id IN ($host) ORDER BY a.triggered_at DESC LIMIT 200",
          "rawQuery": true
        }
      ]
    }
  ]
}
